---
import type { Lang } from '@/scripts/i18n';
import { t } from '@/scripts/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="identity" class="frame identity-frame" aria-label={t(lang, 'nav.identity')}>
  <div class="identity-content">
    <div class="identity-intro">
      <p class="greeting">{lang === 'en' ? "Hi, I'm" : 'Hola, soy'}</p>
      <h1 class="name">Juan José<br />Proaño</h1>
      <p class="role">{t(lang, 'hero.role')}</p>
      <p class="location">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        {t(lang, 'hero.location')}
      </p>
    </div>

    <div class="identity-actions">
      <a href="#contact" class="btn btn-primary">
        {t(lang, 'hero.cta.contact')}
      </a>
      <a href="#work" class="btn btn-secondary">
        {t(lang, 'hero.cta.work')}
      </a>
    </div>
  </div>
</section>

<style>
  .identity-frame {
    display: flex;
    align-items: center;
    min-height: calc(100dvh - var(--header-height));
    padding: var(--space-16) 0;
  }

  .identity-content {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--frame-padding);
    width: 100%;
  }

  .greeting {
    font-size: var(--text-lg);
    color: var(--color-fg-muted);
    margin-bottom: var(--space-2);
    font-weight: 400;
  }

  .name {
    font-size: var(--text-hero);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-4);
  }

  .role {
    font-size: var(--text-xl);
    color: var(--color-fg-secondary);
    margin-bottom: var(--space-3);
    max-width: none;
  }

  .location {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    color: var(--color-fg-muted);
    margin-bottom: var(--space-8);
  }

  .identity-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-base);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--border-radius-md);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-primary {
    color: var(--color-accent-fg);
    background-color: var(--color-accent);
  }

  .btn-primary:hover {
    opacity: 0.85;
  }

  .btn-secondary {
    color: var(--color-fg);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background-color: var(--color-bg-subtle);
  }
</style>
