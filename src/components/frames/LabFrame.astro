---
import type { Lang } from '@/scripts/i18n';
import { t } from '@/scripts/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="lab" class="frame lab-frame" aria-label={t(lang, 'nav.lab')}>
  <div class="frame-container">
    <h2 class="frame-title">{t(lang, 'lab.title')}</h2>
    <p class="lab-description">{t(lang, 'lab.description')}</p>

    <div class="lab-canvas-wrapper" data-lab-mount>
      <!-- Three.js mounts here lazily -->
      <div class="lab-poster" data-lab-poster>
        <div class="poster-content">
          <span class="poster-label">JP</span>
          <p class="poster-hint">
            {lang === 'en' ? 'Click to explore in 3D' : 'Haz clic para explorar en 3D'}
          </p>
        </div>
      </div>
      <noscript>
        <div class="lab-fallback">
          <p>
            {lang === 'en'
              ? '3D interactive experience requires JavaScript.'
              : 'La experiencia interactiva 3D requiere JavaScript.'}
          </p>
        </div>
      </noscript>
    </div>
  </div>
</section>

<style>
  .lab-frame {
    padding: var(--space-16) 0;
  }

  .frame-container {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--frame-padding);
  }

  .frame-title {
    margin-bottom: var(--space-4);
  }

  .lab-description {
    color: var(--color-fg-secondary);
    margin-bottom: var(--space-8);
  }

  .lab-canvas-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
  }

  .lab-poster {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  .lab-poster.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .poster-content {
    text-align: center;
  }

  .poster-label {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--color-fg-faint);
    margin-bottom: var(--space-4);
  }

  .poster-hint {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  .lab-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: var(--space-8);
    text-align: center;
    color: var(--color-fg-muted);
  }
</style>
