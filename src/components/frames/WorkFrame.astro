---
import type { Lang } from '@/scripts/i18n';
import { t } from '@/scripts/i18n';
import { getCollection } from 'astro:content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const allProjects = await getCollection('projects');
const projects = allProjects
  .filter((p) => p.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="work" class="frame work-frame" aria-label={t(lang, 'nav.work')}>
  <div class="frame-container">
    <h2 class="frame-title">{t(lang, 'work.title')}</h2>

    <div class="projects-grid">
      {
        projects.map((project) => (
          <article class="project-card" data-featured={project.data.featured || undefined}>
            <div class="card-header">
              <h3 class="card-title">{project.data.title}</h3>
              <span class={`availability-badge badge-${project.data.codeAvailability.toLowerCase().replace(' ', '-')}`}>
                {t(lang, `work.codeAvailability.${project.data.codeAvailability}` as keyof typeof import('@/scripts/i18n').ui.en)}
              </span>
            </div>
            <p class="card-summary">{project.data.summary}</p>
            <div class="card-stack">
              {project.data.stack.map((tech) => (
                <span class="tech-tag">{tech}</span>
              ))}
            </div>
            <details class="card-details">
              <summary class="details-toggle">
                {lang === 'en' ? 'View case study' : 'Ver caso de estudio'}
              </summary>
              <div class="case-study">
                <div class="case-meta">
                  <div class="meta-item">
                    <strong>{lang === 'en' ? 'Role' : 'Rol'}:</strong> {project.data.role}
                  </div>
                  <div class="meta-item">
                    <strong>{lang === 'en' ? 'Problem' : 'Problema'}:</strong> {project.data.problem}
                  </div>
                </div>
                <div class="case-decisions">
                  <h4>{lang === 'en' ? 'Key Decisions' : 'Decisiones Clave'}</h4>
                  {project.data.decisions.map((d) => (
                    <div class="decision">
                      <strong>{d.title}:</strong> {d.description}
                    </div>
                  ))}
                </div>
                <div class="case-outcome">
                  <h4>{lang === 'en' ? 'Outcome' : 'Resultado'}</h4>
                  <p>{project.data.outcome}</p>
                </div>
              </div>
            </details>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work-frame {
    padding: var(--space-16) 0;
  }

  .frame-container {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--frame-padding);
  }

  .frame-title {
    margin-bottom: var(--space-10);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: var(--space-6);
  }

  .project-card {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    background-color: var(--color-bg-elevated);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .project-card:hover {
    border-color: var(--color-fg-faint);
    box-shadow: var(--shadow-md);
  }

  .project-card[data-featured] {
    grid-column: span 1;
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .card-title {
    font-size: var(--text-lg);
  }

  .availability-badge {
    flex-shrink: 0;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--border-radius-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    white-space: nowrap;
  }

  .badge-public {
    background-color: var(--color-bg-muted);
    color: var(--color-fg);
  }

  .badge-private {
    background-color: var(--color-bg-subtle);
    color: var(--color-fg-muted);
  }

  .badge-on-request {
    background-color: var(--color-bg-subtle);
    color: var(--color-fg-secondary);
  }

  .card-summary {
    font-size: var(--text-sm);
    color: var(--color-fg-secondary);
    margin-bottom: var(--space-4);
  }

  .card-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .tech-tag {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    padding: var(--space-1) var(--space-2);
    background-color: var(--color-bg-subtle);
    border-radius: var(--border-radius-sm);
    color: var(--color-fg-secondary);
  }

  .card-details {
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-4);
  }

  .details-toggle {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-fg-secondary);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .details-toggle:hover {
    color: var(--color-fg);
  }

  .case-study {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .case-study h4 {
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }

  .meta-item {
    font-size: var(--text-sm);
    color: var(--color-fg-secondary);
    margin-bottom: var(--space-2);
  }

  .decision {
    font-size: var(--text-sm);
    color: var(--color-fg-secondary);
    margin-bottom: var(--space-2);
  }

  .case-outcome p {
    font-size: var(--text-sm);
    color: var(--color-fg-secondary);
  }
</style>
