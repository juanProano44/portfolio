---
import type { Lang } from '@/scripts/i18n';
import { t } from '@/scripts/i18n';
import { getCollection } from 'astro:content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const allSkills = await getCollection('skills');
const skillsEntry = allSkills.find((s) => s.data.lang === lang);
const categories = skillsEntry?.data.categories ?? [];
---

<section id="stack" class="frame stack-frame" aria-label={t(lang, 'nav.stack')}>
  <div class="frame-container">
    <h2 class="frame-title">{t(lang, 'stack.title')}</h2>

    <div class="skills-grid">
      {
        categories.map((category) => (
          <div class="skill-category">
            <h3 class="category-name">{category.name}</h3>
            <ul class="skill-list" role="list">
              {category.items.map((item) => (
                <li class="skill-item">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stack-frame {
    padding: var(--space-16) 0;
  }

  .frame-container {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--frame-padding);
  }

  .frame-title {
    margin-bottom: var(--space-10);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--space-8);
  }

  .category-name {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .skill-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .skill-item {
    font-size: var(--text-sm);
    color: var(--color-fg-secondary);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border-subtle);
    font-family: var(--font-mono);
  }

  .skill-item:last-child {
    border-bottom: none;
  }
</style>
