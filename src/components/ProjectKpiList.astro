---
export interface ProjectKpi {
  label: string;
  value: string;
}

interface Props {
  kpis: ProjectKpi[];
  title: string;
  variant?: 'card' | 'detail';
}

const { kpis, title, variant = 'card' } = Astro.props;
---

{
  kpis.length > 0 && (
<div class:list={['kpi-block', variant === 'detail' && 'kpi-block--detail']}>
  <h4 class="kpi-heading">{title}</h4>
  <dl class="kpi-list">
    {
      kpis.map((kpi) => (
        <div class="kpi-row">
          <dt>{kpi.label}</dt>
          <dd>{kpi.value}</dd>
        </div>
      ))
    }
  </dl>
</div>
  )
}

<style>
  .kpi-block {
    margin-bottom: var(--space-4);
  }

  .kpi-block--detail {
    margin-bottom: 0;
  }

  .kpi-heading {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-fg-muted);
    margin-bottom: var(--space-3);
  }

  .kpi-list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  .kpi-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--border-radius-sm);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border-subtle);
  }

  .kpi-row dt {
    font-size: var(--text-xs);
    color: var(--color-fg-secondary);
    margin: 0;
  }

  .kpi-row dd {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-fg);
    margin: 0;
    text-align: right;
  }

  @media (max-width: 380px) {
    .kpi-row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .kpi-row dd {
      text-align: left;
    }
  }
</style>