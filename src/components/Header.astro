---
import type { Lang } from '@/scripts/i18n';
import { t } from '@/scripts/i18n';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import LangSwitch from '@/components/ui/LangSwitch.astro';
import { withBase } from '@/lib/paths';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const frames = [
  { id: 'identity', label: t(lang, 'nav.identity') },
  { id: 'work', label: t(lang, 'nav.work') },
  { id: 'stack', label: t(lang, 'nav.stack') },
  { id: 'experience', label: t(lang, 'nav.experience') },
  { id: 'lab', label: t(lang, 'nav.lab') },
  { id: 'contact', label: t(lang, 'nav.contact') },
] as const;
---

<header class="site-header" role="banner">
  <div class="header-inner">
    <a href={withBase(`${lang}/`)} class="logo-mark" aria-label="JP — Home">
      <span class="logo-text">JP</span>
    </a>

    <nav class="frame-nav" aria-label={lang === 'en' ? 'Main navigation' : 'Navegación principal'}>
      <ul class="nav-list" role="list">
        {
          frames.map((frame) => (
            <li>
              <a href={`#${frame.id}`} class="nav-link" data-frame={frame.id}>
                {frame.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <LangSwitch lang={lang} />
      <ThemeToggle lang={lang} />
      <a href="#contact" class="cta-button">
        {t(lang, 'hero.cta.contact')}
      </a>
    </div>

    <button class="mobile-menu-btn" aria-label="Menu" aria-expanded="false" data-mobile-menu>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>
</header>

<script>
  function initMobileMenu(): void {
    const btn = document.querySelector('[data-mobile-menu]');
    const nav = document.querySelector('.frame-nav');
    if (!btn || !nav) return;

    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      nav.classList.toggle('is-open');
    });

    nav.querySelectorAll('.nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        btn.setAttribute('aria-expanded', 'false');
        nav.classList.remove('is-open');
      });
    });
  }

  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    height: var(--header-height);
    background-color: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--frame-padding);
  }

  .logo-mark {
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    color: var(--color-fg);
  }

  .frame-nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .nav-list {
    display: flex;
    gap: var(--space-1);
  }

  .nav-link {
    display: block;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-fg-muted);
    text-decoration: none;
    border-radius: var(--border-radius-md);
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-fg);
    background-color: var(--color-bg-muted);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent-fg);
    background-color: var(--color-accent);
    border-radius: var(--border-radius-md);
    text-decoration: none;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .cta-button:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .mobile-menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-fg);
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .frame-nav {
      position: fixed;
      top: var(--header-height);
      left: 0;
      right: 0;
      background-color: var(--color-bg);
      border-bottom: 1px solid var(--color-border-subtle);
      padding: var(--space-4);
      transform: translateY(-100%);
      opacity: 0;
      pointer-events: none;
      transition:
        transform var(--duration-normal) var(--ease-out),
        opacity var(--duration-normal) var(--ease-out);
    }

    .frame-nav.is-open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .nav-list {
      flex-direction: column;
      gap: var(--space-1);
    }

    .nav-link {
      padding: var(--space-3) var(--space-4);
      font-size: var(--text-base);
    }

    .cta-button {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }
  }
</style>
