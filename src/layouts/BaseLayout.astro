---
import '@/styles/base.css';
import type { Lang } from '@/scripts/i18n';
import { absoluteUrl, withBase } from '@/lib/paths';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  canonicalPath?: string;
}

const { lang, title, description, canonicalPath } = Astro.props;
const origin = Astro.site?.origin ?? '';
const localePath = `${lang}/${canonicalPath ?? ''}`;
const canonicalUrl = absoluteUrl(localePath, origin);
const hrefEn = absoluteUrl(`en/${canonicalPath ?? ''}`, origin);
const hrefEs = absoluteUrl(`es/${canonicalPath ?? ''}`, origin);
const fontPreload = withBase('fonts/space-grotesk-latin-wght-normal.woff2');
const favicon = withBase('favicon.svg');
---

<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical + hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={hrefEn} />
    <link rel="alternate" hreflang="es" href={hrefEs} />
    <link rel="alternate" hreflang="x-default" href={hrefEn} />

    <!-- Preload critical fonts -->
    <link rel="preload" href={fontPreload} as="font" type="font/woff2" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={favicon} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_EC'} />
    <meta property="og:site_name" content="Juan Proaño" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD Person -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Juan José Proaño",
      "jobTitle": lang === 'en' ? "Full Stack Developer" : "Desarrollador Full Stack",
      "url": canonicalUrl,
      "sameAs": [
        "https://github.com/juanProano44",
        "https://www.linkedin.com/in/juanjoseproano/"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Quito",
        "addressCountry": "EC"
      },
      "knowsAbout": ["React", "TypeScript", "NestJS", "AWS", "Terraform", "Docker", "PostgreSQL"]
    })} />

    <!--
      Inline theme script: runs before first paint to avoid FOUC.
      Sets data-theme from localStorage or system preference.
      CSP hash must match this exact script content.
    -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <a href={`#main-content`} class="skip-link">
      {lang === 'en' ? 'Skip to content' : 'Ir al contenido'}
    </a>

    <!-- Dot field background -->
    <canvas class="dotfield-canvas" data-dotfield-canvas aria-hidden="true"></canvas>

    <!-- Intro overlay -->
    <div class="intro-overlay" data-intro-overlay aria-hidden="true">
      <button class="skip-intro" data-skip-intro>
        {lang === 'en' ? 'Skip intro' : 'Saltar intro'}
      </button>
      <canvas class="intro-canvas" data-intro-canvas></canvas>
    </div>

    <slot name="header" />

    <main id="main-content">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>

<style>
  .dotfield-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: var(--z-base);
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-out);
  }

  .intro-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-intro);
    background-color: var(--color-bg);
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  .intro-canvas {
    width: 100%;
    height: 100%;
  }

  .skip-intro {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: var(--z-skip);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-fg-muted);
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .skip-intro:hover {
    color: var(--color-fg);
    border-color: var(--color-fg-faint);
  }

  .skip-link {
    position: absolute;
    top: calc(-1 * var(--header-height) - var(--space-8));
    left: var(--space-4);
    z-index: var(--z-skip);
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent);
    color: var(--color-accent-fg);
    font-weight: 600;
    font-size: var(--text-sm);
    border-radius: var(--border-radius-sm);
    text-decoration: none;
    transition: top var(--duration-fast) var(--ease-out);
  }

  .skip-link:focus {
    top: var(--space-2);
  }
</style>
