---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import IdentityFrame from '@/components/frames/IdentityFrame.astro';
import WorkFrame from '@/components/frames/WorkFrame.astro';
import StackFrame from '@/components/frames/StackFrame.astro';
import ExperienceFrame from '@/components/frames/ExperienceFrame.astro';
import LabFrame from '@/components/frames/LabFrame.astro';
import ContactFrame from '@/components/frames/ContactFrame.astro';

const lang = 'en' as const;
---

<script>
  import '@/scripts/board';
  import '@/scripts/intro';
  import '@/scripts/dots';
  // Lab is lazy-loaded via IntersectionObserver in its own module
  const labMount = document.querySelector('[data-lab-mount]');
  if (labMount) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          import('@/scripts/lab');
          observer.disconnect();
        }
      },
      { rootMargin: '300px' },
    );
    observer.observe(labMount);
    document.querySelector('[data-lab-poster]')?.addEventListener('click', () => {
      import('@/scripts/lab');
      observer.disconnect();
    }, { once: true });
  }
</script>

<BaseLayout
  lang={lang}
  title="Juan Proaño — Full Stack Developer"
  description="Full stack developer with AWS and cloud deployment experience. Building scalable web applications with React, TypeScript, NestJS, and Terraform."
>
  <Header lang={lang} slot="header" />

  <div class="board" data-board>
    <IdentityFrame lang={lang} />
    <WorkFrame lang={lang} />
    <StackFrame lang={lang} />
    <ExperienceFrame lang={lang} />
    <LabFrame lang={lang} />
    <ContactFrame lang={lang} />
  </div>

  <Footer lang={lang} slot="footer" />
</BaseLayout>
